{
  "Name": "Package",
  "Tag": "PackageService",
  "Operations": [
    {
      "Name": "DeletePackagesInstallingById",
      "OperationId": "deletePackagesInstallingById",
      "Method": "DELETE",
      "Path": "/Packages/Installing/{Id}",
      "Description": "Cancels a package installation",
      "PathParameters": [
        {
          "Name": "Id",
          "Argument": "id",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "ExpectedStatusCodes": [
        200,
        204
      ]
    },
    {
      "Name": "GetPackages",
      "OperationId": "getPackages",
      "Method": "GET",
      "Path": "/Packages",
      "Description": "Gets available packages",
      "Options": [
        {
          "Name": "PackageType",
          "Field": "PackageType",
          "In": "Query",
          "Description": "Optional package type filter (System/UserInstalled)",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "TargetSystems",
          "Field": "TargetSystems",
          "In": "Query",
          "Description": "Optional. Filter by target system type. Allows multiple, comma delimited.",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "IsPremium",
          "Field": "IsPremium",
          "In": "Query",
          "Description": "Optional. Filter by premium status",
          "Type": {
            "Type": "Boolean"
          }
        },
        {
          "Name": "IsAdult",
          "Field": "IsAdult",
          "In": "Query",
          "Description": "Optional. Filter by package that contain adult content.",
          "Type": {
            "Type": "Boolean"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "List",
          "NestedItem": {
            "Type": "Reference",
            "ReferenceName": "PackageInfo"
          }
        }
      },
      "ExpectedStatusCodes": [
        200,
        204
      ]
    },
    {
      "Name": "GetPackagesByName",
      "OperationId": "getPackagesByName",
      "Method": "GET",
      "Path": "/Packages/{Name}",
      "Description": "Gets a package, by name or assembly guid",
      "PathParameters": [
        {
          "Name": "Name",
          "Argument": "name",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Options": [
        {
          "Name": "AssemblyGuid",
          "Field": "AssemblyGuid",
          "In": "Query",
          "Description": "The guid of the associated assembly",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "PackageInfo"
        }
      },
      "ExpectedStatusCodes": [
        200,
        204
      ]
    },
    {
      "Name": "GetPackagesUpdates",
      "OperationId": "getPackagesUpdates",
      "Method": "GET",
      "Path": "/Packages/Updates",
      "Description": "Gets available package updates for currently installed packages",
      "Options": [
        {
          "Name": "PackageType",
          "Field": "PackageType",
          "In": "Query",
          "Description": "Package type filter (System/UserInstalled)",
          "Required": true,
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "List",
          "NestedItem": {
            "Type": "Reference",
            "ReferenceName": "PackageVersionInfo"
          }
        }
      },
      "ExpectedStatusCodes": [
        200,
        204
      ]
    },
    {
      "Name": "PostPackagesInstalledByName",
      "OperationId": "postPackagesInstalledByName",
      "Method": "POST",
      "Path": "/Packages/Installed/{Name}",
      "Description": "Installs a package",
      "PathParameters": [
        {
          "Name": "Name",
          "Argument": "name",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Options": [
        {
          "Name": "AssemblyGuid",
          "Field": "AssemblyGuid",
          "In": "Query",
          "Description": "Guid of the associated assembly",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "Version",
          "Field": "Version",
          "In": "Query",
          "Description": "Optional version. Defaults to latest version.",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "UpdateClass",
          "Field": "UpdateClass",
          "In": "Query",
          "Description": "Optional update class (Dev, Beta, Release). Defaults to Release.",
          "Type": {
            "Type": "Reference",
            "ReferenceName": "PackageVersionClass"
          }
        }
      ],
      "ExpectedStatusCodes": [
        200,
        204
      ]
    },
    {
      "Name": "PostPackagesInstallingByIdDelete",
      "OperationId": "postPackagesInstallingByIdDelete",
      "Method": "POST",
      "Path": "/Packages/Installing/{Id}/Delete",
      "Description": "Cancels a package installation",
      "PathParameters": [
        {
          "Name": "Id",
          "Argument": "id",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "ExpectedStatusCodes": [
        200,
        204
      ]
    }
  ],
