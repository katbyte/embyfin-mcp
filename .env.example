# copy to .env (gitignored) next to docker-compose.yml
# media server API key: Emby dashboard -> Advanced -> API Keys; Jellyfin dashboard -> API Keys
EMBYFIN_TOKEN=
# bearer token clients must send to the MCP endpoint; e.g. openssl rand -hex 32
EMBYFIN_AUTH_TOKEN=
# optional: a TMDB API key or read access token, for audit_provider, audit_missing_episodes with provider true, the TMDB episode in audit_file_path, and show_missing on a server with no record of a series' run
EMBYFIN_TMDB_TOKEN=
