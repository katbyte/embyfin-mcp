        {
          "Name": "itemId",
          "Argument": "itemId",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "LyricDto"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetRemoteLyrics",
      "OperationId": "GetRemoteLyrics",
      "Method": "GET",
      "Path": "/Providers/Lyrics/{lyricId}",
      "Description": "Gets the remote lyrics.",
      "PathParameters": [
        {
          "Name": "lyricId",
          "Argument": "lyricId",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "LyricDto"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "SearchRemoteLyrics",
      "OperationId": "SearchRemoteLyrics",
      "Method": "GET",
      "Path": "/Audio/{itemId}/RemoteSearch/Lyrics",
      "Description": "Search remote lyrics.",
      "PathParameters": [
        {
          "Name": "itemId",
          "Argument": "itemId",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "List",
          "NestedItem": {
            "Type": "Reference",
            "ReferenceName": "RemoteLyricInfoDto"
          }
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "UploadLyrics",
      "OperationId": "UploadLyrics",
      "Method": "POST",
      "Path": "/Audio/{itemId}/Lyrics",
      "Description": "Upload an external lyric file.",
      "PathParameters": [
        {
          "Name": "itemId",
          "Argument": "itemId",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Options": [
        {
          "Name": "fileName",
          "Field": "FileName",
          "In": "Query",
          "Description": "Name of the file being uploaded.",
          "Required": true,
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Request": {
        "ContentType": "text/plain",
        "Type": {
          "Type": "RawFile"
        }
      },
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "LyricDto"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    }
  ],
  "Models": [
