{
  "Name": "Lyric",
  "Tag": "Lyric",
  "Operations": [
    {
      "Name": "DeleteLyrics",
      "OperationId": "DeleteLyrics",
      "Method": "DELETE",
      "Path": "/Audio/{itemId}/Lyrics",
      "Description": "Deletes an external lyric file.",
      "PathParameters": [
        {
          "Name": "itemId",
          "Argument": "itemId",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "ExpectedStatusCodes": [
        204
      ]
    },
    {
      "Name": "DownloadRemoteLyrics",
      "OperationId": "DownloadRemoteLyrics",
      "Method": "POST",
      "Path": "/Audio/{itemId}/RemoteSearch/Lyrics/{lyricId}",
      "Description": "Downloads a remote lyric.",
      "PathParameters": [
        {
          "Name": "itemId",
          "Argument": "itemId",
          "Type": {
            "Type": "String"
          }
        },
        {
          "Name": "lyricId",
          "Argument": "lyricId",
          "Type": {
            "Type": "String"
          }
        }
      ],
      "Response": {
        "ContentType": "application/json",
        "Type": {
          "Type": "Reference",
          "ReferenceName": "LyricDto"
        }
      },
      "ExpectedStatusCodes": [
        200
      ]
    },
    {
      "Name": "GetLyrics",
      "OperationId": "GetLyrics",
      "Method": "GET",
      "Path": "/Audio/{itemId}/Lyrics",
      "Description": "Gets an item's lyrics.",
